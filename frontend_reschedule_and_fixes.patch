+  /// POST /timetable/slots/{slotId}/reschedule/
+  /// Moves a class to a new day/time/room. Only allowed for slots this
+  /// lecturer actually teaches (enforced server-side). On success, the
+  /// backend also notifies every enrolled student — nothing further to
+  /// send from the app.
+  Future<void> rescheduleSlot({
+    required String slotId,
+    String? dayOfWeek, // 'mon'..'sat' — matches TimetableSlot.WeekDay values
+    String? startTime, // 'HH:mm' or 'HH:mm:ss'
+    String? endTime,
+    String? roomId,
+    String? reason,
+  }) async {
+    try {
+      await apiClient.dio.post('timetable/slots/$slotId/reschedule/', data: {
+        if (dayOfWeek != null) 'day_of_week': dayOfWeek,
+        if (startTime != null) 'start_time': startTime,
+        if (endTime != null) 'end_time': endTime,
+        if (roomId != null) 'room': roomId,
+        if (reason != null && reason.isNotEmpty) 'reason': reason,
+      });
+    } on DioException catch (e) {
+      if (e.response?.statusCode == 409) {
+        final detail = (e.response?.data is Map) ? e.response?.data['detail'] : null;
+        throw RescheduleConflictException(detail?.toString() ?? 'That room is already booked at that time.');
+      }
+      throw _handleError(e);
+    } catch (e) {
+      throw _handleError(e);
+    }
+  }
