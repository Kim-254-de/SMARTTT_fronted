+/// Bottom sheet for POST /timetable/slots/{id}/reschedule/.
+/// On success, refreshes the dashboard so this lecturer sees the new
+/// day/time/room immediately — students see it the next time they open
+/// their own schedule, since it's read live from the same TimetableSlot.
+Future<void> showRescheduleSheet(BuildContext context, LecturerSessionModel session) {
+  return showModalBottomSheet(
+    context: context,
+    isScrollControlled: true,
+    shape: const RoundedRectangleBorder(borderRadius: BorderRadius.vertical(top: Radius.circular(20))),
+    builder: (_) => _RescheduleSheet(session: session),
+  );
+}
